{
	"name": "@foomo/contentfultree",
	"version": "1.2.0",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"author": "foomo",
	"license": "MIT",
	"scripts": {
		"clean": "rm -f ./tsconfig.tsbuildinfo && rm -rvf dist",
		"build": "tsc -b",
		"rebuild": "pnpm clean && pnpm build",
		"dev": "pnpm tsc -b tsconfig.json -w",
		"lint": "biome check --write .",
		"deps:dedupe": "pnpm dedupe && git diff --quiet pnpm-lock.yaml || (echo 'Lockfile changed — review and commit.' && git diff --stat pnpm-lock.yaml)"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@contentful/app-sdk": "^4.70.0",
		"@types/react": "19.3.0",
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"@contentful/app-sdk": ">=4",
		"contentful-management": ">=12",
		"react": ">=18"
	}
}
